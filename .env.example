# ---------------------------------------------------------------
# Rele-search: environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# --- Embeddings (used for retrieval / vector search) ---
# OpenAI embedding model used to embed both the corpus and queries.
EMBEDDING_MODEL=text-embedding-3-small
# Output vector size. 1536 is the model's full size; smaller values are allowed.
EMBEDDING_DIM=1536

# --- LLM (text generation) ---
# Used to generate answers, and for any LLM step in retrieval
# (query rewriting, reranking).
GENERATION_MODEL=gpt-4.1
# Optional: set this to use a different model for retrieval-side LLM steps.
# If left blank, GENERATION_MODEL is used.
RETRIEVAL_MODEL=
GENERATION_TEMPERATURE=0.0

# Minimum seconds between API calls. Raise this if you hit rate limits.
LLM_CALL_DELAY=0
# Seconds before a single API call is abandoned (and retried).
LLM_TIMEOUT=120
# Maximum output tokens per chat call. A reply that hits this is treated as a failed call.
LLM_MAX_TOKENS=4000

# --- Retrieval ---
TOP_K=8

# --- Data ---
CHANGELOG_PATH=data/tessera_changelog.json
COMPLAINTS_PATH=data/tessera_complaints.json
STORE_PATH=data/store.json
RUNS_DIR=runs

# --- Prompt ---
# Show record dates to the LLM (PRD open question: run both ways once).
INCLUDE_DATES_IN_PROMPT=true

# --- Full agent: relevancy check (the baseline ignores these) ---
# One status log per method is written here, e.g. data/status/hybrid.json
STATUS_DIR=data/status
# Model that judges whether a release fixes a complaint (llm and hybrid methods).
# If left blank, GENERATION_MODEL is used.
RELEVANCY_MODEL=
# similarity method: a release outdates a complaint when cosine similarity >= this.
# Tune on the dev split only. 0.55 is for text-embedding-3-small (0.80 was used with Gemini).
SIMILARITY_THRESHOLD=0.55
# llm and hybrid methods: how many of the most similar earlier complaints the model judges per release.
RELEVANCY_CANDIDATES=10
# Judge "decisions" only (python -m src update --judge decisions): model for the OpenAI Decisions API.
# The API supports only gpt-6-luna.
DECISIONS_MODEL=gpt-6-luna
