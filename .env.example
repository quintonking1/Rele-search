# ---------------------------------------------------------------
# Rele-search: environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Embeddings (used for retrieval / vector search) ---
# Gemini embedding model used to embed both the corpus and queries.
EMBEDDING_MODEL=gemini-embedding-2
# Output vector size: 128-3072 supported; 768, 1536, or 3072 recommended.
EMBEDDING_DIM=768
# gemini-embedding-2 has no task_type; the code adds retrieval prefixes ("task: search result | query: ..." / "title: ... | text: ...").

# --- LLM (text generation) ---
# Used to generate answers, and for any LLM step in retrieval
# (query rewriting, reranking).
GENERATION_MODEL=gemini-3.6-flash
# Optional: set this to use a different model for retrieval-side LLM steps.
# If left blank, GENERATION_MODEL is used.
RETRIEVAL_MODEL=
GENERATION_TEMPERATURE=0.0

# --- Retrieval ---
TOP_K=8

# --- Data ---
CHANGELOG_PATH=data/tessera_changelog.json
COMPLAINTS_PATH=data/tessera_complaints.json
STORE_PATH=data/store.json
RUNS_DIR=runs

# --- Prompt ---
# Show record dates to the LLM (PRD open question: run both ways once).
INCLUDE_DATES_IN_PROMPT=true
